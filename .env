# TreiNa — dados do Supabase (login com Google + backup na nuvem)
# Usado no teste pelo Expo Go e no APK. O SITE pega estes valores das
# "Variables" do repositório no GitHub (veja o guia).
# Copie do Supabase: Project Settings > API Keys (URL do projeto e a chave "Publishable").
EXPO_PUBLIC_SUPABASE_URL=https://COLE-AQUI.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE-AQUI-sb_publishable_xxxxxxxx
